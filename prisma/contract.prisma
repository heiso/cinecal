// use prisma-8

namespace public {
  // Singleton row (id is always 1) holding cross-run scraper state.
  model AppState {
    id                   Int                           @id @default(1)
    // Set when a showtimes scrape completes without being cut short by rate
    // limiting. The poster cleanup only deletes posters when this is recent,
    // so a partial (429-truncated) run never wrongly deletes a poster for a
    // movie whose showtimes are just temporarily missing.
    lastCompleteScrapeAt DateTime(storage: timestamp)? @map("last_complete_scrape_at")

    @@map("app_state")
  }

  model Movie {
    id                Int                                   @id @default(autoincrement())
    createdAt         DateTime(storage: timestamp)          @default(now()) @onCreate(now()) @map("created_at")
    updatedAt         DateTime(storage: timestamp)          @onCreate(now()) @onUpdate(now()) @map("updated_at")
    allocineId        Int                                   @map("allocine_id")
    themoviedbId      Int?                                  @map("themoviedb_id")
    releaseDate       DateTime(storage: timestamp)?         @map("release_date")
    title             String(storage: varchar, length: 255)
    originalTitle     String(storage: varchar, length: 255) @map("original_title")
    synopsis          String?
    duration          Int                                   @default(0)
    director          String?
    posterAllocineUrl String?                               @map("poster_allocine_url")
    posterUrl         String?                               @map("poster_url")
    posterBlurHash    String?                               @map("poster_blur_hash")
    Showtimes         Showtime[]
    Tags              MovieTag[]

    @@index([allocineId], map: "movies_allocine_id_key", unique: true)
    @@map("movies")
  }

  model MovieTag {
    id              Int                                    @id @default(autoincrement())
    name            String(storage: varchar, length: 255)
    regExp          String(storage: varchar, length: 255)? @map("reg_exp")
    isFilterEnabled Boolean                                @default(false) @map("is_filter_enabled")
    featured        Boolean                                @default(false)
    category        pg.enum(TagCategory)
    Movies          Movie[]

    @@index([name], map: "movie_tags_name_key", unique: true)
    @@map("movie_tags")
  }

  // Junction of Movie.Tags <-> MovieTag.Movies (Prisma 7 implicit many-to-many table).
  model MovieToMovieTag {
    movieId Int      @map("A")
    tagId   Int      @map("B")
    Movie   Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "_MovieToMovieTag_AB_pkey")
    Tag     MovieTag @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@id([movieId, tagId], map: "_MovieToMovieTag_AB_pkey")
    @@index([tagId], map: "_MovieToMovieTag_B_index")
    @@map("_MovieToMovieTag")
  }

  model Theater {
    id         Int                                   @id @default(autoincrement())
    createdAt  DateTime(storage: timestamp)          @default(now()) @onCreate(now()) @map("created_at")
    updatedAt  DateTime(storage: timestamp)          @onCreate(now()) @onUpdate(now()) @map("updated_at")
    allocineId String(storage: varchar, length: 10)  @map("allocine_id")
    name       String(storage: varchar, length: 255)
    address    String
    website    String(storage: varchar, length: 255)
    Showtimes  Showtime[]

    @@index([allocineId], map: "theaters_allocine_id_key", unique: true)
    @@map("theaters")
  }

  model Showtime {
    id           Int                          @id @default(autoincrement())
    createdAt    DateTime(storage: timestamp) @default(now()) @onCreate(now()) @map("created_at")
    updatedAt    DateTime(storage: timestamp) @onCreate(now()) @onUpdate(now()) @map("updated_at")
    allocineId   BigInt(as: number)           @map("allocine_id")
    date         DateTime(storage: timestamp)
    isPreview    Boolean                      @default(false) @map("is_preview")
    language     pg.enum(Language)
    ticketingUrl String?
    theaterId    Int                          @map("theater_id")
    movieId      Int                          @map("movie_id")
    Prices       Price[]
    Tags         ShowtimeTag[]
    Theater      Theater                      @relation(fields: [theaterId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)
    Movie        Movie                        @relation(fields: [movieId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)

    @@index([date, movieId, theaterId], map: "showtimes_date_movie_id_theater_id_key", unique: true)
    @@index([allocineId], map: "showtimes_allocine_id_key", unique: true)
    @@map("showtimes")
  }

  model Price {
    id          Int       @id @default(autoincrement())
    label       String
    description String?
    price       Float
    showtimeId  Int?
    Showtime    Showtime? @relation(fields: [showtimeId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)

    @@map("prices")
  }

  model ScrapedUrl {
    url       String                       @id
    createdAt DateTime(storage: timestamp) @default(now()) @onCreate(now()) @map("created_at")
    expiresAt DateTime(storage: timestamp) @map("expires_at")
    content   String
    type      pg.enum(ScrapedUrlType)

    @@map("scraped_urls")
  }

  model ShowtimeTag {
    id              Int                                    @id @default(autoincrement())
    name            String(storage: varchar, length: 255)
    regExp          String(storage: varchar, length: 255)? @map("reg_exp")
    isFilterEnabled Boolean                                @default(false) @map("is_filter_enabled")
    featured        Boolean                                @default(false)
    Showtimes       Showtime[]

    @@index([name], map: "showtime_tags_name_key", unique: true)
    @@map("showtime_tags")
  }

  // Junction of Showtime.Tags <-> ShowtimeTag.Showtimes (Prisma 7 implicit many-to-many table).
  model ShowtimeToShowtimeTag {
    showtimeId Int         @map("A")
    tagId      Int         @map("B")
    Showtime   Showtime    @relation(fields: [showtimeId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "_ShowtimeToShowtimeTag_AB_pkey")
    Tag        ShowtimeTag @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@id([showtimeId, tagId], map: "_ShowtimeToShowtimeTag_AB_pkey")
    @@index([tagId], map: "_ShowtimeToShowtimeTag_B_index")
    @@map("_ShowtimeToShowtimeTag")
  }

  native_enum ScrapedUrlType {
    SHOWTIMES = "SHOWTIMES"
    TICKETING = "TICKETING"
  }

  native_enum TagCategory {
    GENRE = "GENRE"
    SUB_GENRE = "SUB_GENRE"
    CHARACTERISTIC = "CHARACTERISTIC"
    AWARD = "AWARD"
  }

  native_enum Language {
    VO = "VO"
    VF = "VF"
  }
}
