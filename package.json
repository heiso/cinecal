{
  "name": "cinecal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "react-router dev",
    "prebuild": "prisma contract emit",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "npm run icons && react-router typegen && tsc",
    "lint": "npm run typecheck && oxlint && oxfmt --check && prisma migration check",
    "format": "oxfmt",
    "test": "vitest run",
    "icons": "node scripts/generate-svg-icons-sprite.ts",
    "scraper": "node --env-file-if-exists=.env cli/index.ts",
    "db:emit": "prisma contract emit",
    "db:plan": "prisma migration plan --name",
    "db:migrate": "prisma db migrate --advance-ref db",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.ts",
    "reset-database": "docker compose exec -T postgres psql -U postgres -c 'DROP DATABASE IF EXISTS cinecal WITH (FORCE)' -c 'CREATE DATABASE cinecal' && npm run db:migrate && npm run db:seed",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "check-dependencies": "npx npm-check-updates --peer --format group -i"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@unpic/pixels": "^1.3.0",
    "@unpic/placeholder": "^0.1.2",
    "blurhash": "^2.0.5",
    "date-fns": "^4.4.0",
    "isbot": "^5.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "msw": "^3.0.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "prisma": "8.0.0-rc.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  }
}
