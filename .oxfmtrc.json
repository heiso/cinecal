{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "sortImports": {
    "newlinesBetween": false,
    "groups": ["builtin", "external", ["parent", "sibling", "index"], "unknown"]
  },
  "sortTailwindcss": {
    "stylesheet": "./app/app.css"
  },
  "ignorePatterns": [
    "package-lock.json",
    "build",
    ".react-router",
    "svgs.ts",
    "public/icons.svg",
    ".claude",
    "src/prisma/contract.json",
    "src/prisma/contract.d.ts",
    "migrations"
  ]
}
