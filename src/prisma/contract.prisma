// use prisma-8

// Singleton row (id is always 1) holding cross-run scraper state.
model AppState {
  id                   Int       @id @default(1)
  // Set when a showtimes scrape completes without being cut short by rate
  // limiting. The poster cleanup only deletes posters when this is recent,
  // so a partial (429-truncated) run never wrongly deletes a poster for a
  // movie whose showtimes are just temporarily missing.
  lastCompleteScrapeAt DateTime? @map("last_complete_scrape_at")

  @@map("app_state")
}

model Movie {
  id                Int                @id @default(autoincrement())
  createdAt         temporal.CreatedAt @map("created_at")
  updatedAt         temporal.UpdatedAt @map("updated_at")
  allocineId        Int                @unique @map("allocine_id")
  // A calendar date, read as "yyyy-MM-dd"
  releaseDate       Date?              @map("release_date")
  title             String
  originalTitle     String             @map("original_title")
  synopsis          String?
  duration          Int                @default(0)
  director          String?
  posterAllocineUrl String?            @map("poster_allocine_url")
  posterUrl         String?            @map("poster_url")
  posterBlurHash    String?            @map("poster_blur_hash")
  Showtimes         Showtime[]
  Tags              MovieTag[]

  @@map("movies")
}

model MovieTag {
  id              Int                 @id @default(autoincrement())
  name            String              @unique
  regExp          String?             @map("reg_exp")
  isFilterEnabled Boolean             @default(false) @map("is_filter_enabled")
  featured        Boolean             @default(false)
  category        pg.enum(TagCategory)
  Movies          Movie[]

  @@map("movie_tags")
}

// Join model of Movie.Tags <-> MovieTag.Movies
model MovieToMovieTag {
  movieId Int      @map("movie_id")
  tagId   Int      @map("tag_id")
  Movie   Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  Tag     MovieTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([movieId, tagId])
  @@map("movies_movie_tags")
}

model Theater {
  id         Int                @id @default(autoincrement())
  createdAt  temporal.CreatedAt @map("created_at")
  updatedAt  temporal.UpdatedAt @map("updated_at")
  allocineId String             @unique @map("allocine_id")
  name       String
  address    String
  website    String
  Showtimes  Showtime[]

  @@map("theaters")
}

model Showtime {
  id           Int                @id @default(autoincrement())
  createdAt    temporal.CreatedAt @map("created_at")
  updatedAt    temporal.UpdatedAt @map("updated_at")
  allocineId   BigInt(as: number) @unique @map("allocine_id")
  date         DateTime
  isPreview    Boolean            @default(false) @map("is_preview")
  language     pg.enum(Language)
  ticketingUrl String?            @map("ticketing_url")
  theaterId    Int                @map("theater_id")
  movieId      Int                @map("movie_id")
  Prices       Price[]
  Tags         ShowtimeTag[]
  Theater      Theater            @relation(fields: [theaterId], references: [id], onDelete: Cascade)
  Movie        Movie              @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([date, movieId, theaterId])
  @@map("showtimes")
}

model Price {
  id          Int       @id @default(autoincrement())
  label       String
  description String?
  price       Float
  showtimeId  Int?      @map("showtime_id")
  Showtime    Showtime? @relation(fields: [showtimeId], references: [id], onDelete: Cascade)

  @@map("prices")
}

model ScrapedUrl {
  url       String                  @id
  createdAt temporal.CreatedAt      @map("created_at")
  expiresAt DateTime                @map("expires_at")
  content   String
  type      pg.enum(ScrapedUrlType)

  @@map("scraped_urls")
}

model ShowtimeTag {
  id              Int        @id @default(autoincrement())
  name            String     @unique
  regExp          String?    @map("reg_exp")
  isFilterEnabled Boolean    @default(false) @map("is_filter_enabled")
  featured        Boolean    @default(false)
  Showtimes       Showtime[]

  @@map("showtime_tags")
}

// Join model of Showtime.Tags <-> ShowtimeTag.Showtimes
model ShowtimeToShowtimeTag {
  showtimeId Int         @map("showtime_id")
  tagId      Int         @map("tag_id")
  Showtime   Showtime    @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  Tag        ShowtimeTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([showtimeId, tagId])
  @@map("showtimes_showtime_tags")
}

native_enum ScrapedUrlType {
  SHOWTIMES = "SHOWTIMES"
  TICKETING = "TICKETING"
}

native_enum TagCategory {
  GENRE = "GENRE"
  SUB_GENRE = "SUB_GENRE"
  CHARACTERISTIC = "CHARACTERISTIC"
  AWARD = "AWARD"
}

native_enum Language {
  VO = "VO"
  VF = "VF"
}
